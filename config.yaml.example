# Index-Translate 配置示例
# 复制为 config.yaml 即可使用；服务首次启动也会自动生成该文件。
# 修改后重启服务生效（通过 /settings 页面修改则立即生效）。

server:
  # 服务监听端口
  port: 8787
  # 监听地址，0.0.0.0 表示所有网卡
  host: "0.0.0.0"
  # CORS 允许来源
  corsOrigin: "*"

upstream:
  # 上游 Index-Translate 服务地址
  base: "https://index-translate.bilibili.com"

auth:
  # 是否启用 API Key 鉴权（默认开启）
  enabled: true
  # 允许的 API Key 列表；开启鉴权但为空时会自动生成
  keys:
    - "sk-replace-with-your-own-key"
  # 系统设置页访问秘钥（默认 admin）；留空则关闭设置页鉴权
  settingsKey: "admin"

defaults:
  # 默认模型：index-mt-2b / index-mt-9b / index-mt-35b
  #           index-chat-2b / index-chat-9b / index-chat-35b
  model: "index-mt-9b"
  # 翻译模型默认源语言（auto 为自动检测）
  sourceLang: "auto"
  # 翻译模型默认目标语言
  targetLang: "zh"
